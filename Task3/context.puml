@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Context Diagram – Банковская система (депозиты и кредиты)

Person(customer, "Клиент", "Физическое лицо, использует сайт или интернет-банк для подачи заявок на депозиты и кредиты")
Person(backoffice, "Сотрудник бэк-офиса", "Обрабатывает заявки, подтверждает условия")
Person(manager, "Менеджер отделения", "Работает с клиентами при идентификации и выдаче продукта")

System_Boundary(bank, "Банковская система") {
    System(ibank, "Интернет-банк", "Онлайн-кабинет клиента: депозиты, кредиты, предодобренные предложения")
    System(site, "Публичный сайт", "Доступен новым клиентам: депозиты и кредиты, подача заявок")
    System(core, "ABS (Автоматизированная банковская система)", "Хранение и обработка депозитов и кредитов")
    System(conveyor, "Кредитный конвейер", "Хранение и согласование условий кредитов")
    System(scoring, "Скоринговая система", "Проверка кредитных заявок и интеграция с БКИ")
    System(notify, "Сервис уведомлений (SMS)", "Отправка кодов подтверждения и информирование клиентов")
}

Rel(customer, site, "Просмотр условий и подача заявок")
Rel(customer, ibank, "Работа с депозитами и кредитами, подтверждение через SMS")
Rel(customer, manager, "Личная идентификация в отделении")

Rel(backoffice, core, "Подтверждение условий депозитов и кредитов")
Rel(backoffice, conveyor, "Работа с условиями кредитов")

Rel(manager, core, "Создание/обновление заявок при визите клиента")

Rel(ibank, core, "Интеграция через API/шину", "Internal API")
Rel(site, core, "Интеграция через API/шину", "Internal API")

Rel(core, conveyor, "Запрос условий по кредитам")
Rel(core, scoring, "Запрос кредитной истории и оценки риска")
Rel(core, notify, "Отправка SMS уведомлений")

@enduml
